{
  "schema": "org.steinsos.design-tokens",
  "version": "0.1-proposal",
  "status": "Design proposal. Not installed theme values or a complete desktop API.",
  "units": {
    "length": "device-independent pixels at 100% scale",
    "time": "milliseconds",
    "font": "DIP target sizes; implementations derive from user font/scale settings"
  },
  "color": {
    "canvas": "#101820",
    "panel": "#151f28",
    "raised": "#1d2a35",
    "raisedHover": "#293946",
    "input": "#0c1319",
    "border": "#435767",
    "text": "#eee9df",
    "muted": "#a9b6bf",
    "subtle": "#90a3af",
    "selection": "#334657",
    "accent": "#efad60",
    "onAccent": "#101820",
    "success": "#a9cd9a",
    "warning": "#efc476",
    "error": "#f3978b",
    "info": "#8ecada"
  },
  "worldlines": {
    "alpha": {
      "name": "Alpha",
      "divergence": "0.571024",
      "accent": "#ec887d",
      "mood": "copper dusk / experimental origin"
    },
    "steins-gate": {
      "name": "Steins Gate",
      "divergence": "1.048596",
      "accent": "#efad60",
      "mood": "amber summer / urban laboratory"
    },
    "hinamizawa": {
      "name": "Hinamizawa",
      "divergence": "2.198306",
      "accent": "#b8ca81",
      "mood": "moss green / rural summer stillness"
    },
    "hitogashima": {
      "name": "Hitogashima",
      "divergence": "3.072100",
      "accent": "#72c9dc",
      "mood": "sea glass / luminous coast"
    },
    "lugunica": {
      "name": "Lugunica",
      "divergence": "4.250801",
      "accent": "#b6a0ec",
      "mood": "violet / atmospheric fantasy stone"
    },
    "mitakihara": {
      "name": "Mitakihara",
      "divergence": "5.093001",
      "accent": "#e6a7d4",
      "mood": "rose / elegant geometric city"
    }
  },
  "typography": {
    "uiFamily": "Noto Sans",
    "terminalFamily": "DejaVu Sans Mono",
    "tubeFamily": "preserve existing tube renderer",
    "sizes": {
      "caption": 12,
      "body": 14,
      "control": 14,
      "section": 18,
      "title": 24,
      "display": 32,
      "terminal": 14,
      "panelDigits": 18
    },
    "weights": {
      "body": 400,
      "label": 500,
      "selected": 600
    },
    "lineHeightRatio": 1.45,
    "tracking": {
      "body": 0,
      "smallLabel": 0.4,
      "tubeDigits": 0.8
    },
    "rules": [
      "No decorative font for authentication or mail content.",
      "No forced uppercase paragraphs.",
      "Keep terminal selectable text and glyph fallback."
    ]
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "small": 4,
    "control": 8,
    "window": 12,
    "panel": 16,
    "tubeCell": 6
  },
  "stroke": {
    "icon": 1.75,
    "border": 1,
    "focus": 2,
    "activeIndicator": 2
  },
  "geometry": {
    "panelHeight": 56,
    "panelSideInset": 28,
    "panelBottomInset": 20,
    "controlTarget": 40,
    "compactControlTarget": 36,
    "captionHeight": 42,
    "windowControlTarget": 36,
    "iconCanvas": 24,
    "iconVisibleBounds": [
      2,
      2,
      22,
      22
    ],
    "compactMeterPreferredWidth": 184,
    "compactMeterMinimumWidth": 160,
    "compactMeterHeight": 46,
    "launcherPreferredWidth": 430,
    "navigatorPreferredWidth": 530,
    "navigatorCardWidth": 486
  },
  "motion": {
    "microFeedback": 100,
    "panelReveal": 160,
    "windowOpen": 180,
    "proposedShiftFullMaximum": 900,
    "proposedShiftReducedMaximum": 180,
    "curves": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "exit": [
        0.4,
        0,
        1,
        1
      ]
    },
    "proposedShiftFullTarget": 800,
    "default": "reduced",
    "settings": [
      "off",
      "reduced",
      "full"
    ],
    "rules": [
      "No rapid flashing or full-screen luminance pulses.",
      "No input interception during a worldline shift.",
      "State/theme recovery does not depend on an effect."
    ]
  },
  "audio": {
    "defaultEnabled": false,
    "navigationHoverSound": false,
    "maximumConcurrentCues": 1,
    "rules": [
      "System mute and user volume always win.",
      "No ambient track by default.",
      "A failed shift never plays the success cue."
    ]
  },
  "accessibility": {
    "normalTextContrastMinimum": 4.5,
    "focusContrastMinimum": 3,
    "focus": "2 DIP accent ring with 2 DIP gap; retain visible shape difference from selection",
    "smallControlMaximumDensity": "36 DIP compact pointer target; 40 DIP preferred; touch uses 44 DIP",
    "status": "label + geometry/icon, never colour alone"
  }
}
